<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="VitalBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="12"/>
        <Setter Property="Background" Value="#16202B"/>
        <Setter Property="Foreground" Value="{StaticResource GradientFrostActive}"/>
        <Setter Property="BorderBrush" Value="#204A6075"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid Height="{TemplateBinding Height}">
                        <Border CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border Margin="1"
                                CornerRadius="5"
                                ClipToBounds="True"
                                Background="Transparent">
                            <Grid HorizontalAlignment="Left"
                                  Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value}">
                                <Rectangle RadiusX="5"
                                           RadiusY="5"
                                           Fill="{TemplateBinding Foreground}"/>
                                <Rectangle Width="38"
                                           HorizontalAlignment="Right"
                                           Fill="#77E8F7FF"
                                           Opacity="0.58"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModeTileButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="168"/>
        <Setter Property="Background" Value="#10161E"/>
        <Setter Property="BorderBrush" Value="#2A495C70"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="Foreground" Value="{StaticResource BrushIceWhite}"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>

                        <Border x:Name="RootBorder"
                                CornerRadius="18"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border Margin="1.5"
                                        CornerRadius="16"
                                        Background="#081018"/>

                                <Border x:Name="GlowLayer"
                                        Margin="1.5"
                                        CornerRadius="16"
                                        Background="{TemplateBinding Tag}"
                                        Opacity="0.10">
                                    <Border.Effect>
                                        <BlurEffect Radius="24"/>
                                    </Border.Effect>
                                </Border>

                                <Border Margin="8"
                                        CornerRadius="12"
                                        BorderBrush="{TemplateBinding Tag}"
                                        BorderThickness="1.2"
                                        Opacity="0.36"/>

                                <Rectangle x:Name="TopEdge"
                                           Height="2.2"
                                           RadiusX="1.1"
                                           RadiusY="1.1"
                                           Fill="{TemplateBinding Tag}"
                                           Opacity="0.65"
                                           VerticalAlignment="Top"
                                           Margin="22,12,22,0"/>

                                <Rectangle x:Name="BottomEdge"
                                           Height="2.2"
                                           RadiusX="1.1"
                                           RadiusY="1.1"
                                           Fill="{TemplateBinding Tag}"
                                           Opacity="0.42"
                                           VerticalAlignment="Bottom"
                                           Margin="22,0,22,12"/>

                                <Rectangle Width="2.2"
                                           Fill="{TemplateBinding Tag}"
                                           Opacity="0.22"
                                           HorizontalAlignment="Left"
                                           Margin="12,28,0,28"/>
                                <Rectangle Width="2.2"
                                           Fill="{TemplateBinding Tag}"
                                           Opacity="0.14"
                                           HorizontalAlignment="Right"
                                           Margin="0,28,12,28"/>

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>

                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Width="22"
                                Height="22"
                                Margin="8"
                                BorderBrush="{TemplateBinding Tag}"
                                BorderThickness="1.2,1.2,0,0"
                                Opacity="0.85"/>

                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Width="22"
                                Height="22"
                                Margin="8"
                                BorderBrush="{TemplateBinding Tag}"
                                BorderThickness="0,0,1.2,1.2"
                                Opacity="0.85"/>

                        <Border x:Name="PressFlash"
                                CornerRadius="18"
                                Background="#22FFFFFF"
                                Opacity="0"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="#90D8F6FF"/>
                            <Setter TargetName="RootBorder" Property="Background" Value="#182330"/>
                            <Setter TargetName="GlowLayer" Property="Opacity" Value="0.18"/>
                            <Setter TargetName="TopEdge" Property="Opacity" Value="0.95"/>
                            <Setter TargetName="BottomEdge" Property="Opacity" Value="0.70"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="#091119"/>
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="#B8F2FF"/>
                            <Setter TargetName="GlowLayer" Property="Opacity" Value="0.30"/>
                            <Setter TargetName="TopEdge" Property="Opacity" Value="1"/>
                            <Setter TargetName="BottomEdge" Property="Opacity" Value="0.86"/>
                            <Setter TargetName="PressFlash" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>