<UserControl x:Class="JotunnSystem.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JotunnSystem"
             xmlns:models="clr-namespace:JotunnSystem.Models"
             Background="Black">

    <UserControl.Resources>
        <local:ModeToBrushConverter x:Key="ModeToBrushConverter"/>
        <local:ModeToDisplayNameConverter x:Key="ModeToDisplayNameConverter"/>
        <local:ModeEqualsConverter x:Key="ModeEqualsConverter"/>
        <local:IntensityToScaleConverter x:Key="IntensityToScaleConverter"/>
        <local:IntensityToOpacityConverter x:Key="IntensityToOpacityConverter"/>
        <local:IntensityToWaveScaleConverter x:Key="IntensityToWaveScaleConverter"/>
        <local:IntensityToStrokeThicknessConverter x:Key="IntensityToStrokeThicknessConverter"/>
        <local:ModeToAuthorityRoleConverter x:Key="ModeToAuthorityRoleConverter"/>
        <local:ModeToAuthorityGlyphConverter x:Key="ModeToAuthorityGlyphConverter"/>
        <local:BoolToAuthorityStateConverter x:Key="BoolToAuthorityStateConverter"/>
        <local:ValueEqualsToBooleanConverter x:Key="ValueEqualsToBooleanConverter"/>
        <local:ValueEqualsToVisibilityConverter x:Key="ValueEqualsToVisibilityConverter"/>

        <Style x:Key="NavButtonBaseStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#D8F4FF"/>
            <Setter Property="Background" Value="#140B1420"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShadowTileStyle" TargetType="Button">
            <Setter Property="Opacity" Value="0.72"/>
            <Setter Property="Background" Value="#160B1420"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VitalBarStyle" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="#32D7FF"/>
            <Setter Property="Background" Value="#2E3A45"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#14364654"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <Border x:Name="PART_Track"
                                    Margin="1"
                                    Background="Transparent"
                                    CornerRadius="3"/>
                            <Border x:Name="PART_Indicator"
                                    Margin="1"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WingCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Background" Value="#4A09121B"/>
            <Setter Property="BorderBrush" Value="#1800D4FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F0FCFF"/>
            <Setter Property="Background" Value="#160B1420"/>
            <Setter Property="BorderBrush" Value="#1FBEE9FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LauncherCardStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderBrush" Value="#1A7FDBFF"/>
        </Style>

        <Style x:Key="SteamLauncherStyle" TargetType="Button" BasedOn="{StaticResource LauncherCardStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveGamingPlatform}" Value="Steam">
                    <Setter Property="Background" Value="#1A102334"/>
                    <Setter Property="BorderBrush" Value="#FF32D7FF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#FF32D7FF" Opacity="0.45"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EpicLauncherStyle" TargetType="Button" BasedOn="{StaticResource LauncherCardStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveGamingPlatform}" Value="Epic">
                    <Setter Property="Background" Value="#1A102334"/>
                    <Setter Property="BorderBrush" Value="#FF32D7FF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#FF32D7FF" Opacity="0.45"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GogLauncherStyle" TargetType="Button" BasedOn="{StaticResource LauncherCardStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveGamingPlatform}" Value="GOG">
                    <Setter Property="Background" Value="#1A102334"/>
                    <Setter Property="BorderBrush" Value="#FF32D7FF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#FF32D7FF" Opacity="0.45"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BattleNetLauncherStyle" TargetType="Button" BasedOn="{StaticResource LauncherCardStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveGamingPlatform}" Value="Battle.net">
                    <Setter Property="Background" Value="#1A102334"/>
                    <Setter Property="BorderBrush" Value="#FF32D7FF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#FF32D7FF" Opacity="0.45"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrepCardStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#120B1420"/>
            <Setter Property="BorderBrush" Value="#1832D7FF"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style x:Key="SanctumServiceStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#15111A2C"/>
            <Setter Property="BorderBrush" Value="#245B72B8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <Grid>
                                <Border Margin="1"
                                        CornerRadius="17"
                                        BorderBrush="#12FFFFFF"
                                        BorderThickness="1"
                                        Opacity="0.18"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CrunchyrollServiceStyle" TargetType="Button" BasedOn="{StaticResource SanctumServiceStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveMediaService}" Value="Crunchyroll">
                    <Setter Property="Background" Value="#20172230"/>
                    <Setter Property="BorderBrush" Value="#FF6F7BFF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#FF6F7BFF" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HiDiveServiceStyle" TargetType="Button" BasedOn="{StaticResource SanctumServiceStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveMediaService}" Value="HIDIVE">
                    <Setter Property="Background" Value="#20172230"/>
                    <Setter Property="BorderBrush" Value="#FF6F7BFF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#FF6F7BFF" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DisneyServiceStyle" TargetType="Button" BasedOn="{StaticResource SanctumServiceStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveMediaService}" Value="Disney+">
                    <Setter Property="Background" Value="#20172230"/>
                    <Setter Property="BorderBrush" Value="#FF6F7BFF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#FF6F7BFF" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimeServiceStyle" TargetType="Button" BasedOn="{StaticResource SanctumServiceStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveMediaService}" Value="Prime Video">
                    <Setter Property="Background" Value="#20172230"/>
                    <Setter Property="BorderBrush" Value="#FF6F7BFF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#FF6F7BFF" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NetflixServiceStyle" TargetType="Button" BasedOn="{StaticResource SanctumServiceStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveMediaService}" Value="Netflix">
                    <Setter Property="Background" Value="#20172230"/>
                    <Setter Property="BorderBrush" Value="#FF6F7BFF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#FF6F7BFF" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SanctumPostureStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#130F1626"/>
            <Setter Property="BorderBrush" Value="#1F6F7BFF"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style x:Key="LowNoisePostureStyle" TargetType="Button" BasedOn="{StaticResource SanctumPostureStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding MediaWingStatus}" Value="Low-noise sanctum posture staged under Bellion.">
                    <Setter Property="Background" Value="#20172230"/>
                    <Setter Property="BorderBrush" Value="#FF6F7BFF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="#FF6F7BFF" Opacity="0.4"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BalancedPostureStyle" TargetType="Button" BasedOn="{StaticResource SanctumPostureStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding MediaWingStatus}" Value="Balanced sanctum posture staged under Bellion.">
                    <Setter Property="Background" Value="#20172230"/>
                    <Setter Property="BorderBrush" Value="#FF6F7BFF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="#FF6F7BFF" Opacity="0.4"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ImmersionPostureStyle" TargetType="Button" BasedOn="{StaticResource SanctumPostureStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding MediaWingStatus}" Value="Immersion sanctum posture staged under Tusk.">
                    <Setter Property="Background" Value="#20172230"/>
                    <Setter Property="BorderBrush" Value="#FF6F7BFF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="#FF6F7BFF" Opacity="0.4"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.16" RadiusX="0.95" RadiusY="1.08">
                <GradientStop Color="#0C1A29" Offset="0"/>
                <GradientStop Color="#07121C" Offset="0.42"/>
                <GradientStop Color="#02060B" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid x:Name="BootOverlay"
              Background="#F2000000"
              Panel.ZIndex="999"
              Opacity="1"
              IsHitTestVisible="False">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="BootOverlay"
                                             Storyboard.TargetProperty="Opacity"
                                             From="1"
                                             To="0"
                                             BeginTime="0:0:2.5"
                                             Duration="0:0:1.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="SYSTEM INITIALIZING"
                           FontSize="22"
                           Foreground="#D8F4FF"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>
                <TextBlock Text="LINKING SHADOW AUTHORITY"
                           FontSize="16"
                           Foreground="#7FA7B8"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Ellipse Width="1080"
                 Height="1080"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,-420,0,0"
                 Fill="#1700D4FF"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="190"/>
            </Ellipse.Effect>
        </Ellipse>

        <Ellipse Width="940"
                 Height="940"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Margin="0,0,0,-420"
                 Fill="#0900D4FF"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="180"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="18"
                    Background="#58060C14"
                    BorderBrush="#24BEE9FF"
                    BorderThickness="1"
                    Padding="18,12"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTime}"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="#E7F8FF"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding CurrentDate}"
                                           FontSize="11"
                                           Foreground="#8FB5C7"/>
                                <TextBlock Text="  UPTIME  "
                                           FontSize="11"
                                           Foreground="#597D8D"/>
                                <TextBlock Text="{Binding SystemUptime}"
                                           FontSize="11"
                                           Foreground="#7EA9BB"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="ASHBORN"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="{Binding CurrentMode, Converter={StaticResource ModeToBrushConverter}}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="THRONE // CASTLE NETWORK"
                                       FontSize="10"
                                       Foreground="#5E8192"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <UniformGrid Grid.Row="1"
                                 Columns="4"
                                 Margin="0,14,0,0">
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Home" Margin="0,0,8,0" Content="HOME">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDomain, Converter={StaticResource ValueEqualsToBooleanConverter}, ConverterParameter=Home}" Value="True">
                                            <Setter Property="Background" Value="#26111C28"/>
                                            <Setter Property="BorderBrush" Value="{Binding CurrentMode, Converter={StaticResource ModeToBrushConverter}}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#FFFFFFFF" Opacity="0.28"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Armory" Margin="8,0" Content="ARMORY">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDomain, Converter={StaticResource ValueEqualsToBooleanConverter}, ConverterParameter=Armory}" Value="True">
                                            <Setter Property="Background" Value="#26111C28"/>
                                            <Setter Property="BorderBrush" Value="#FF00D4FF"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#FF00D4FF" Opacity="0.35"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="System" Margin="8,0" Content="SYSTEM">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDomain, Converter={StaticResource ValueEqualsToBooleanConverter}, ConverterParameter=System}" Value="True">
                                            <Setter Property="Background" Value="#26111C28"/>
                                            <Setter Property="BorderBrush" Value="{Binding CurrentMode, Converter={StaticResource ModeToBrushConverter}}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#FFFFFFFF" Opacity="0.28"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="Sanctum" Margin="8,0,0,0" Content="SANCTUM">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDomain, Converter={StaticResource ValueEqualsToBooleanConverter}, ConverterParameter=Sanctum}" Value="True">
                                            <Setter Property="Background" Value="#26111C28"/>
                                            <Setter Property="BorderBrush" Value="#FF6F7BFF"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#FF6F7BFF" Opacity="0.38"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- HOME CHAMBER -->
            <Grid Grid.Row="1"
                  Visibility="{Binding CurrentDomain, Converter={StaticResource ValueEqualsToVisibilityConverter}, ConverterParameter=Home}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4.15*"/>
                    <RowDefinition Height="1.7*"/>
                    <RowDefinition Height="2.75*"/>
                    <RowDefinition Height="1.15*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        CornerRadius="20"
                        Background="#50081219"
                        BorderBrush="#18BEE9FF"
                        BorderThickness="1"
                        Padding="18,14"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="78"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU" FontSize="13" Foreground="#7CA1B3" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Margin="12,0" Value="{Binding SystemMonitor.CpuUsage}" Maximum="100" Style="{StaticResource VitalBarStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding SystemMonitor.CpuUsageText}" FontSize="18" Foreground="#E7F8FF" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="78"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GPU" FontSize="13" Foreground="#7CA1B3" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Margin="12,0" Value="{Binding SystemMonitor.GpuUsage}" Maximum="100" Style="{StaticResource VitalBarStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding SystemMonitor.GpuUsageText}" FontSize="18" Foreground="#E7F8FF" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="78"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RAM" FontSize="13" Foreground="#7CA1B3" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Margin="12,0" Value="{Binding SystemMonitor.RamUsagePercent}" Maximum="100" Style="{StaticResource VitalBarStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding SystemMonitor.RamUsagePercent, StringFormat={}{0:F0}%}" FontSize="18" Foreground="#E7F8FF" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        CornerRadius="30"
                        Background="#3E071018"
                        BorderBrush="#18BEE9FF"
                        BorderThickness="1"
                        Margin="0,0,0,14">
                    <Grid>
                        <Ellipse Width="800"
                                 Height="800"
                                 Fill="{Binding CurrentMode, Converter={StaticResource ModeToBrushConverter}}"
                                 Opacity="0.07"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Ellipse.Effect>
                                <BlurEffect Radius="188"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <Grid x:Name="CorePulseContainer"
                              Width="566"
                              Height="566"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="{Binding ModeIntensity, Converter={StaticResource IntensityToScaleConverter}}"
                                                ScaleY="{Binding ModeIntensity, Converter={StaticResource IntensityToScaleConverter}}"/>
                            </Grid.RenderTransform>

                            <Ellipse Width="526"
                                     Height="526"
                                     Stroke="{Binding CurrentMode, Converter={StaticResource ModeToBrushConverter}}"
                                     StrokeThickness="2.2"
                                     StrokeDashArray="14 10"
                                     Opacity="0.42"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:40"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>

