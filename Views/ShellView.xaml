<UserControl x:Class="JotunnSystem.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JotunnSystem"
             xmlns:models="clr-namespace:JotunnSystem.Models"
             Background="#080D10">

    <UserControl.Resources>
        <local:ValueEqualsToVisibilityConverter x:Key="ValueEqualsToVisibilityConverter"/>
        <local:ValueEqualsToBooleanConverter x:Key="ValueEqualsToBooleanConverter"/>

        <Style x:Key="ForgePanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#7AB06F1C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F00A0E10" Offset="0"/>
                        <GradientStop Color="#E914181C" Offset="0.55"/>
                        <GradientStop Color="#F0080D10" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ForgeInnerPanel" TargetType="Border" BasedOn="{StaticResource ForgePanel}">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="#4BB06F1C"/>
            <Setter Property="Background" Value="#B80B1013"/>
        </Style>

        <Style x:Key="ForgeButton" TargetType="Button">
            <Setter Property="Background" Value="#94110F0C"/>
            <Setter Property="BorderBrush" Value="#B06F1C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E6B966"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#E6B966"/>
                                <Setter TargetName="Root" Property="Background" Value="#C018120B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E026170A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ForgeButton}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#523A2715"/>
            <Setter Property="Foreground" Value="#D9C08B"/>
            <Setter Property="Background" Value="#70101214"/>
        </Style>

        <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource ForgeButton}">
            <Setter Property="MinHeight" Value="92"/>
            <Setter Property="Background" Value="#A00B1013"/>
            <Setter Property="BorderBrush" Value="#665A3616"/>
            <Setter Property="Foreground" Value="#E6ECEB"/>
        </Style>

        <Style x:Key="ForgeProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Foreground" Value="#4AA3FF"/>
            <Setter Property="Background" Value="#55232A2E"/>
            <Setter Property="BorderBrush" Value="#442A3337"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6B966"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#849AA2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6ECEB"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/FenrirForgeworks/Textures/blackened_iron.png"
                        TileMode="Tile"
                        Viewport="0,0,360,360"
                        ViewportUnits="Absolute"
                        Stretch="None"
                        Opacity="0.35"/>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12" MaxWidth="980">

                <!-- GLOBAL HEADER -->
                <Border Style="{StaticResource ForgePanel}" MinHeight="132" BorderBrush="#AAB06F1C">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="/Assets/FenrirForgeworks/Identity/fenrir_wolf_crest.png"
                               Width="54" Height="54" Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="FENRIR FORGEWORKS" Style="{StaticResource HeaderText}" FontSize="24"/>
                            <TextBlock Text="JOTUNN COMMAND CORE" Foreground="#D9C08B" FontFamily="Georgia" FontSize="11" Margin="2,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CurrentTime}" Foreground="#E6ECEB" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding CurrentDate}" Foreground="#849AA2" FontSize="10" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding SystemUptime, StringFormat=UPTIME {0}}" Foreground="#849AA2" FontSize="10" HorizontalAlignment="Right"/>
                        </StackPanel>

                        <UniformGrid Grid.Row="1" Grid.ColumnSpan="3" Columns="4" Margin="0,14,0,0">
                            <Button Content="CORE" Command="{Binding NavigateCommand}" CommandParameter="Home" Style="{StaticResource NavButton}" Margin="0,0,6,0"/>
                            <Button Content="ARMORY" Command="{Binding NavigateCommand}" CommandParameter="Armory" Style="{StaticResource NavButton}" Margin="6,0"/>
                            <Button Content="CORE HEALTH" Command="{Binding NavigateCommand}" CommandParameter="System" Style="{StaticResource NavButton}" Margin="6,0"/>
                            <Button Content="SANCTUM" Command="{Binding NavigateCommand}" CommandParameter="Sanctum" Style="{StaticResource NavButton}" Margin="6,0,0,0"/>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- TOP SIGNAL STRIP -->
                <UniformGrid Columns="3" Margin="0,0,0,12">
                    <Border Style="{StaticResource ForgeInnerPanel}" Margin="0,0,6,0" MinHeight="190">
                        <StackPanel>
                            <TextBlock Text="HEIMDALL SIGNALS" Style="{StaticResource HeaderText}" FontSize="11"/>
                            <TextBlock Text="WATCH ACTIVE" Foreground="#4AA3FF" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Signal feed stable" Style="{StaticResource MutedText}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ForgeInnerPanel}" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="FORGEKEEPER" Style="{StaticResource HeaderText}" FontSize="11"/>
                            <TextBlock Text="5" Foreground="#FFB022" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Alerts active" Style="{StaticResource MutedText}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ForgeInnerPanel}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="OPENCLAW BRIDGE" Style="{StaticResource HeaderText}" FontSize="11"/>
                            <TextBlock Text="ONLINE" Foreground="#5ED631" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Relay active" Style="{StaticResource MutedText}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- COMMAND CORE -->
                <Grid Visibility="{Binding CurrentDomain, Converter={StaticResource ValueEqualsToVisibilityConverter}, ConverterParameter=Home}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="0.9*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource ForgePanel}" MinHeight="132" Margin="0,0,8,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="JOTUNN CORE HEALTH" Style="{StaticResource HeaderText}" FontSize="15"/>
                                    <Grid Grid.Row="1" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="/Assets/FenrirForgeworks/Identity/purple_command_rune.png" Width="96" Height="96" Opacity="0.92"/>
                                        <Grid Grid.Column="1" Margin="12,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="CPU" Style="{StaticResource MutedText}"/>
                                            <ProgressBar Grid.Column="1" Value="{Binding SystemMonitor.CpuUsage}" Maximum="100" Style="{StaticResource ForgeProgress}" Margin="0,4,8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SystemMonitor.CpuUsageText}" Foreground="#E6ECEB" HorizontalAlignment="Right"/>

                                            <TextBlock Grid.Row="1" Text="GPU" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                            <ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding SystemMonitor.GpuUsage}" Maximum="100" Style="{StaticResource ForgeProgress}" Margin="0,12,8,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SystemMonitor.GpuUsageText}" Foreground="#E6ECEB" HorizontalAlignment="Right" Margin="0,8,0,0"/>

                                            <TextBlock Grid.Row="2" Text="RAM" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                            <ProgressBar Grid.Row="2" Grid.Column="1" Value="{Binding SystemMonitor.RamUsagePercent}" Maximum="100" Style="{StaticResource ForgeProgress}" Margin="0,12,8,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SystemMonitor.RamUsagePercent, StringFormat={}{0:F0}%}" Foreground="#E6ECEB" HorizontalAlignment="Right" Margin="0,8,0,0"/>

                                            <TextBlock Grid.Row="3" Text="TEMP" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SystemMonitor.CpuTemperatureText, StringFormat=CPU {0}}" Foreground="#E6B966" Margin="0,8,0,0"/>
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SystemMonitor.GpuTemperatureText}" Foreground="#E6B966" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                        </Grid>
                                    </Grid>
                                    <Button Grid.Row="2" Content="VIEW CORE DETAILS" Command="{Binding NavigateCommand}" CommandParameter="System" Style="{StaticResource ForgeButton}" Margin="0,14,0,0"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource ForgePanel}" MinHeight="132" Margin="8,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE DIRECTIVES" Style="{StaticResource HeaderText}" FontSize="15"/>
                                    <Border Style="{StaticResource ForgeInnerPanel}" Margin="0,12,0,8">
                                        <TextBlock Text="Monitor Forgekeeper alerts&#x0a;Continuous" Style="{StaticResource BodyText}" FontSize="12"/>
                                    </Border>
                                    <Border Style="{StaticResource ForgeInnerPanel}">
                                        <TextBlock Text="Daily inventory audit&#x0a;Next: 09:00" Style="{StaticResource BodyText}" FontSize="12"/>
                                    </Border>
                                    <Border Style="{StaticResource ForgeInnerPanel}">
                                        <TextBlock Text="Backup and archive sync&#x0a;Next: 02:00" Style="{StaticResource BodyText}" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ForgePanel}" MinHeight="150" Margin="0,0,8,12">
                                <StackPanel>
                                    <TextBlock Text="SYSTEM OVERVIEW" Style="{StaticResource HeaderText}" FontSize="15"/>
                                    <Image Source="/Assets/FenrirForgeworks/Identity/purple_command_rune.png" Height="120" Margin="0,12" Opacity="0.95"/>
                                    <TextBlock Text="Fenrir Forgeworks command core online. JOTUNN, Heimdall, OpenClaw, and Forgekeeper signals are visible." Style="{StaticResource BodyText}" FontSize="13" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource ForgePanel}" MinHeight="150" Margin="8,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SIGNAL RAIL" Style="{StaticResource HeaderText}" FontSize="15"/>
                                    <Border Style="{StaticResource ForgeInnerPanel}" BorderBrush="#99FF6E24">
                                        <TextBlock Text="Forgekeeper Alert&#x0a;Low filament: PLA+ Black" Foreground="#FFB022" FontSize="12" TextWrapping="Wrap"/>
                                    </Border>
                                    <Border Style="{StaticResource ForgeInnerPanel}" BorderBrush="#885ED631">
                                        <TextBlock Text="Production Complete&#x0a;Recent batch completed" Foreground="#5ED631" FontSize="12" TextWrapping="Wrap"/>
                                    </Border>
                                    <Border Style="{StaticResource ForgeInnerPanel}" BorderBrush="#884AA3FF">
                                        <TextBlock Text="OpenClaw Relay&#x0a;All channels online" Foreground="#4AA3FF" FontSize="12" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ForgePanel}" MinHeight="150" Margin="0,0,8,12">
                                <StackPanel>
                                    <TextBlock Text="ARMORY" Style="{StaticResource HeaderText}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Ready for Action" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                    <Button Content="VIEW ARMORY" Command="{Binding NavigateCommand}" CommandParameter="Armory" Style="{StaticResource ForgeButton}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource ForgePanel}" MinHeight="150" Margin="4,0,4,12">
                                <StackPanel>
                                    <TextBlock Text="SANCTUM" Style="{StaticResource HeaderText}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Rest. Recharge. Reclaim." Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                    <Button Content="ENTER SANCTUM" Command="{Binding NavigateCommand}" CommandParameter="Sanctum" Style="{StaticResource ForgeButton}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource ForgePanel}" MinHeight="150" Margin="8,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="FORGEKEEPER LINK" Style="{StaticResource HeaderText}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Production. Inventory. Intelligence." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,2,0,8"/>
                                    <Button Content="OPEN BRIDGE" Style="{StaticResource ForgeButton}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource ForgePanel}">
                            <StackPanel>
                                <TextBlock Text="HEIMDALL SIGNALS" Style="{StaticResource HeaderText}"/>
                                <Polyline Points="0,22 20,20 35,24 52,14 65,28 82,18 105,20 125,13 150,26 172,16 195,20 218,17 242,22 268,16 292,20 318,18 348,23"
                                          Stroke="#7E5BCB" StrokeThickness="2" Stretch="Fill" Height="44" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding HeimdallStatus}" Style="{StaticResource BodyText}" FontSize="15" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ARMORY -->
                <Grid Visibility="{Binding CurrentDomain, Converter={StaticResource ValueEqualsToVisibilityConverter}, ConverterParameter=Armory}">
                    <StackPanel>
                        <Border Style="{StaticResource ForgePanel}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ARMORY" Style="{StaticResource HeaderText}" FontSize="13"/>
                                    <TextBlock Text="{Binding ActiveGamingPlatform}" Foreground="#E6ECEB" FontSize="32" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding GamingWingStatus}" Style="{StaticResource BodyText}" FontSize="15"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="LAUNCH STATE" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="READY" Foreground="#E6B966" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ForgePanel}" Margin="0,0,8,12">
                                <StackPanel>
                                    <TextBlock Text="LAUNCH NETWORK" Style="{StaticResource HeaderText}"/>
                                    <UniformGrid Columns="2" Margin="0,12,0,0">
                                        <Button Command="{Binding SelectGamingPlatformCommand}" CommandParameter="Steam" Style="{StaticResource TileButton}" Margin="0,0,8,8">
                                            <StackPanel><TextBlock Text="STEAM" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Primary launch network" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel>
                                        </Button>
                                        <Button Command="{Binding SelectGamingPlatformCommand}" CommandParameter="Epic" Style="{StaticResource TileButton}" Margin="8,0,0,8">
                                            <StackPanel><TextBlock Text="EPIC" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Event launch vector" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel>
                                        </Button>
                                        <Button Command="{Binding SelectGamingPlatformCommand}" CommandParameter="GOG" Style="{StaticResource TileButton}" Margin="0,8,8,0">
                                            <StackPanel><TextBlock Text="GOG" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Standalone archive" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel>
                                        </Button>
                                        <Button Command="{Binding SelectGamingPlatformCommand}" CommandParameter="Battle.net" Style="{StaticResource TileButton}" Margin="8,8,0,0">
                                            <StackPanel><TextBlock Text="BATTLE.NET" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Battle.net command path" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/></StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource ForgePanel}" Margin="8,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="LIVE ARMORY STATUS" Style="{StaticResource HeaderText}"/>
                                    <TextBlock Text="{Binding GamingWingStatus}" Style="{StaticResource BodyText}" Margin="0,12,0,12"/>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="CPU" Style="{StaticResource MutedText}"/>
                                        <ProgressBar Grid.Column="1" Value="{Binding SystemMonitor.CpuUsage}" Maximum="100" Style="{StaticResource ForgeProgress}" Margin="0,4,8,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SystemMonitor.CpuUsageText}" Foreground="#E6ECEB" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="1" Text="GPU" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                        <ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding SystemMonitor.GpuUsage}" Maximum="100" Style="{StaticResource ForgeProgress}" Margin="0,12,8,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SystemMonitor.GpuUsageText}" Foreground="#E6ECEB" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                        <TextBlock Grid.Row="2" Text="RAM" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                        <ProgressBar Grid.Row="2" Grid.Column="1" Value="{Binding SystemMonitor.RamUsagePercent}" Maximum="100" Style="{StaticResource ForgeProgress}" Margin="0,12,8,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SystemMonitor.RamUsagePercent, StringFormat={}{0:F0}%}" Foreground="#E6ECEB" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                        <TextBlock Grid.Row="3" Text="INTENSITY" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                        <ProgressBar Grid.Row="3" Grid.Column="1" Value="{Binding ModeIntensity}" Maximum="1" Style="{StaticResource ForgeProgress}" Margin="0,12,8,0"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ModeIntensity, StringFormat={}{0:P0}}" Foreground="#E6ECEB" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource ForgePanel}">
                            <StackPanel>
                                <TextBlock Text="SESSION DIRECTIVES" Style="{StaticResource HeaderText}"/>
                                <TextBlock Text="{Binding GamingWingRecommendation}" Style="{StaticResource BodyText}" Margin="0,8,0,12"/>
                                <UniformGrid Columns="4">
                                    <Button Content="BALANCED" Command="{Binding PrepareGamingSessionCommand}" CommandParameter="Balanced" Style="{StaticResource ForgeButton}" Margin="0,0,6,0"/>
                                    <Button Content="PRECISION" Command="{Binding PrepareGamingSessionCommand}" CommandParameter="Competitive" Style="{StaticResource ForgeButton}" Margin="6,0"/>
                                    <Button Content="PERFORMANCE" Command="{Binding PrepareGamingSessionCommand}" CommandParameter="Performance" Style="{StaticResource ForgeButton}" Margin="6,0"/>
                                    <Button Content="SUSTAIN" Command="{Binding PrepareGamingSessionCommand}" CommandParameter="LongSession" Style="{StaticResource ForgeButton}" Margin="6,0,0,0"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="0.95*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource ForgePanel}" MinHeight="330" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="ARMORY OPERATIONS" Style="{StaticResource HeaderText}" FontSize="13"/>

                                    <Grid Grid.Row="1" Margin="0,14,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Style="{StaticResource ForgeInnerPanel}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Launcher Relay" Foreground="#E6B966" FontWeight="Bold"/>
                                                <TextBlock Text="Steam, Epic, GOG, and Battle.net launch paths remain staged through config." Style="{StaticResource BodyText}" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="1" Style="{StaticResource ForgeInnerPanel}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Desktop Game Access" Foreground="#4AA3FF" FontWeight="Bold"/>
                                                <TextBlock Text="Most-used games can remain desktop-launched while Armory controls platform readiness." Style="{StaticResource BodyText}" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="2" Style="{StaticResource ForgeInnerPanel}">
                                            <StackPanel>
                                                <TextBlock Text="Session Guard" Foreground="#5ED631" FontWeight="Bold"/>
                                                <TextBlock Text="Balanced, precision, performance, and sustain directives remain available." Style="{StaticResource BodyText}" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource ForgePanel}" MinHeight="330" Margin="8,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="SESSION READINESS MATRIX" Style="{StaticResource HeaderText}" FontSize="13"/>

                                    <Grid Grid.Row="1" Margin="0,14,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Style="{StaticResource ForgeInnerPanel}" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
